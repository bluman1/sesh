{
  "name": "sesh",
  "displayName": "Sesh",
  "description": "Browse, annotate, and resume saved Claude Code sessions.",
  "version": "0.0.1",
  "publisher": "michael",
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sesh.open",
        "title": "Sesh: Open"
      },
      {
        "command": "sesh.showStats",
        "title": "Sesh: Show stats"
      },
      {
        "command": "sesh.rescan",
        "title": "Sesh: Rescan all projects"
      }
    ],
    "configuration": {
      "title": "Sesh",
      "properties": {
        "sesh.openOnActivation": {
          "type": "boolean",
          "default": false,
          "description": "Open the Sesh panel automatically when VSCode starts."
        },
        "sesh.transcriptLimit": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum number of transcript messages to load in the detail pane. Returns the most recent messages first; lower this if very long transcripts feel slow to open."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --target=node20 --sourcemap --external:vscode --external:better-sqlite3 --external:fsevents --outfile=out/extension.js && node -e \"require('fs').cpSync('src/db/migrations', 'out/migrations', {recursive:true})\"",
    "build:webview": "cd webview && npm install --no-audit --no-fund && npm run build",
    "watch": "npm run build:extension -- --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
