{
  "name": "sesh",
  "displayName": "Sesh",
  "description": "Browse, annotate, and resume saved Claude Code and Codex CLI sessions.",
  "version": "0.0.1",
  "publisher": "bluman1",
  "license": "MIT",
  "icon": "resources/sesh-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bluman1/sesh.git"
  },
  "bugs": {
    "url": "https://github.com/bluman1/sesh/issues"
  },
  "homepage": "https://github.com/bluman1/sesh#readme",
  "engines": {
    "vscode": "^1.94.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "ai",
    "sessions",
    "transcripts",
    "history",
    "resume",
    "anthropic",
    "openai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sesh.open",
        "title": "Sesh: Open",
        "icon": "$(history)"
      },
      {
        "command": "sesh.showStats",
        "title": "Sesh: Show stats"
      },
      {
        "command": "sesh.rescan",
        "title": "Sesh: Rescan all projects"
      },
      {
        "command": "sesh.archiveSize",
        "title": "Sesh: Show archive size"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sesh",
          "title": "Sesh",
          "icon": "resources/sesh-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "sesh-secondary",
          "title": "Sesh",
          "icon": "resources/sesh-icon.svg"
        }
      ]
    },
    "views": {
      "sesh": [
        {
          "type": "tree",
          "id": "sesh.welcome",
          "name": "Saved sessions"
        }
      ],
      "sesh-secondary": [
        {
          "type": "tree",
          "id": "sesh.welcomeSecondary",
          "name": "Saved sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sesh.welcome",
        "contents": "Browse, annotate, and resume saved Claude Code sessions.\n[Open Sesh panel](command:sesh.open)\n\nA full editor tab opens with your session list, search, filters, and transcript preview."
      },
      {
        "view": "sesh.welcomeSecondary",
        "contents": "Browse, annotate, and resume saved Claude Code sessions.\n[Open Sesh panel](command:sesh.open)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sesh.open",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Sesh",
      "properties": {
        "sesh.openOnActivation": {
          "type": "boolean",
          "default": false,
          "description": "Open the Sesh panel automatically when VSCode starts."
        },
        "sesh.transcriptLimit": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum number of transcript messages to load in the detail pane. Returns the most recent messages first; lower this if very long transcripts feel slow to open."
        },
        "sesh.archiveTranscripts": {
          "type": "boolean",
          "default": false,
          "description": "Keep a gzipped copy of every indexed session JSONL at ~/.sesh/transcripts/<id>.jsonl.gz. Survives Claude Code's transcript pruning so old conversations stay readable. Disk cost: roughly 1/6 the raw JSONL size after gzip; run 'Sesh: Show archive size' to inspect."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --target=node20 --sourcemap --external:vscode --external:better-sqlite3 --external:fsevents --outfile=out/extension.js && node -e \"require('fs').cpSync('src/db/migrations', 'out/migrations', {recursive:true})\"",
    "build:webview": "cd webview && npm install --no-audit --no-fund && npm run build",
    "watch": "npm run build:extension -- --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.94.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
